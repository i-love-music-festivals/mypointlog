{
  // アプリの正式名称（端末の設定画面などで表示される名前）
  "name": "ポイント実績入力",
  // ホーム画面でアイコンの下に表示される短い名前（長すぎると省略されるため短くする）
  "short_name": "ポイント",
  // アプリ起動時に開くURLの場所（「.」は今の場所、つまり index.html を指す）
  "start_url": ".",
  // 画面の表示モード: standalone にすると、URLのアドレスバーなどが消えてアプリっぽくなる
  "display": "standalone",
  // アプリを起動している最中（一瞬）の背景色
  "background_color": "#121212",
  // スマホのステータスバー（時計や電池がある一番上の帯）の色
  "theme_color": "#2A2A2A",
  // ホーム画面に表示するアイコンの設定
  "icons": [
    {
      // アイコン画像の場所（URL）
      "src": "https://i-love-music-festivals.github.io/mypointlog/icon.png",
      // アイコンのサイズ（512x512が推奨サイズ）
      "sizes": "512x512",
      // 画像のファイル形式
      "type": "image/png",
      // アイコンの形をスマホのOSに合わせて自動調整していいよという許可
      "purpose": "any maskable"
    }
  ]
}